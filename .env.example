# Copy to .env and adjust. docker-compose.yml reads these; uvicorn/pytest run on
# the host read them too if you `export $(cat .env | xargs)` or use a tool like
# direnv. Nothing in this file is a real secret -- replace placeholders before
# using this stack against anything but local ParadeDB.

# --- PostgreSQL / ParadeDB (pg_search + pgvector) -----------------------------
POSTGRES_USER=parcelpilot
POSTGRES_PASSWORD=change-me-local-dev-only
POSTGRES_DB=parcelpilot

# --- ParcelPilot API -----------------------------------------------------------
# Host port the API is published on (container always listens on 8000).
API_PORT=8000

# --- Medha / vLLM planner endpoint ---------------------------------------------
# Required: point this at your Medha/vLLM deployment. Never bundled into the
# application image, and deliberately not defaulted here -- do not commit a real
# endpoint URL or key into this file.
MEDHA_BASE_URL=http://medha-host:8001/v1
MEDHA_API_KEY=change-me
MEDHA_MODEL=Medha

# --- Retrieval (optional overrides) ---------------------------------------
# Leave commented out to use the application's own defaults (gte-base-en-v1.5,
# pinned revision, no reranker). Uncomment and set a value to override -- an
# uncommented but empty value is NOT the same as commented out here, since
# docker-compose.yml passes these straight through and an empty string would
# override the code default with "" instead of falling back to it.
# PARCELPILOT_EMBEDDING_MODEL=
# PARCELPILOT_EMBEDDING_REVISION=
# PARCELPILOT_RERANKER_MODEL=
